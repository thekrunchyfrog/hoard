# Database Configuration
# Copy this file to .env and fill in your database credentials
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Server Configuration
PORT=5000

# Admin API token
# Required to use the write endpoints (POST/PUT /api/collections/:id/items...)
# used by the /admin page. Generate a random value, e.g.:
#   openssl rand -hex 32
# The /admin page (frontend) prompts for this token in the browser and
# stores it in sessionStorage - it is not baked in at build time, so there
# is no frontend env var to set.
ADMIN_TOKEN=

# Root directory uploaded item images are stored under (and served from via
# the frontend's static /images path). In Docker this is the shared
# `webapp-images` volume, mounted at /app/images in this container. Defaults
# to /app/images if unset; override for local, non-Docker dev, e.g.:
#   IMAGES_ROOT=../frontend/public/images
IMAGES_ROOT=
